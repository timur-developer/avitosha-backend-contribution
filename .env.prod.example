# Copy this file to .env.prod on the VM. Never commit .env.prod.
APP_ENV=prod
FRONTEND_ORIGIN=https://avitosha.timurgilyazov.ru
CADDY_ACME_EMAIL=

# Use only URL-safe characters in these PostgreSQL values because Compose builds a DSN from them.
POSTGRES_DB=avitosha
POSTGRES_USER=avitosha
POSTGRES_PASSWORD=

JWT_SIGNING_KEY=
JWT_ISSUER=avitosha
JWT_AUDIENCE=avitosha-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Leave the key empty to use the built-in non-AI fallback.
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openrouter/v1
PROXYAPI_MODEL=qwen/qwen-2.5-7b-instruct
PROXYAPI_TIMEOUT=4s
